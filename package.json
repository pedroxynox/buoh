{
  "name": "buoh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "data:replay": "node scripts/data-replay.mjs",
    "docs:check": "node scripts/check-doc-impact.mjs",
    "docs:check:pr": "node scripts/check-doc-impact.mjs --require-base",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "runtime:check": "node scripts/check-runtime.mjs",
    "schemas:check": "pnpm --filter @buoh/contracts run schemas:check",
    "schemas:generate": "pnpm --filter @buoh/contracts run schemas:generate",
    "test": "pnpm run test:docs && pnpm run test:scripts && turbo run test",
    "test:docs": "node --test scripts/check-doc-impact.test.mjs",
    "test:scripts": "node --test scripts/data-replay.test.mjs",
    "test:integration": "turbo run build --filter=@buoh/market-data-worker --output-logs=errors-only && pnpm --filter @buoh/market-data-worker run test:integration",
    "test:vectors": "turbo run test:vectors",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm run verify:core && pnpm run docs:check",
    "verify:core": "pnpm run runtime:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run schemas:check",
    "verify:pr": "pnpm run verify:core && pnpm run docs:check:pr"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
