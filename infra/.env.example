# Copia este archivo a infra/.env (ignorado por Git) y completa los secretos locales.
# Compose y el worker leen las mismas variables. No reutilices estos valores fuera de tu equipo.

BUOH_DEPLOYMENT_ENVIRONMENT=development

# PostgreSQL local (infra/compose.yaml).
BUOH_POSTGRES_HOST=127.0.0.1
BUOH_POSTGRES_PORT=5432
BUOH_POSTGRES_DB=buoh
BUOH_POSTGRES_USER=buoh
BUOH_POSTGRES_PASSWORD=

# Almacenamiento S3-compatible local (SeaweedFS).
BUOH_S3_ENDPOINT=http://127.0.0.1:8333
BUOH_S3_PORT=8333
BUOH_S3_REGION=us-east-1
BUOH_S3_BUCKET=buoh-local
BUOH_S3_ACCESS_KEY_ID=
BUOH_S3_SECRET_ACCESS_KEY=
