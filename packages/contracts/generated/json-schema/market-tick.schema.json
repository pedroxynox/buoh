{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MarketTick",
  "$defs": {
    "MarketTick": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "connector_version": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "event_time_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "received_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "quote_decimal": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "pip_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "origin": {
          "type": "string",
          "enum": [
            "stream",
            "history_recovery"
          ]
        },
        "raw_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tick_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "invalid_source_frame",
              "duplicate_exact",
              "source_time_conflict",
              "out_of_order",
              "delivery_delayed",
              "connection_lost",
              "event_gap_unresolved",
              "persistence_unavailable",
              "source_limit_exceeded"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "observation_id",
        "source",
        "connector_version",
        "symbol",
        "event_time_utc",
        "received_at_utc",
        "quote_decimal",
        "pip_size",
        "origin",
        "raw_payload_sha256",
        "tick_fingerprint_sha256",
        "quality_flags"
      ],
      "additionalProperties": false,
      "title": "MarketTick"
    }
  }
}
