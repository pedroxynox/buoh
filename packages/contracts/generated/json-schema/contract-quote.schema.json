            },
            "commission_decimal": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            }
          },
          "required": [
            "schema_version",
            "observation_id",
            "source",
            "connector_version",
            "symbol",
            "currency",
            "stake_decimal",
            "quoted_at_utc",
            "ask_price_decimal",
            "received_at_utc",
            "raw_payload_sha256",
            "contract_category",
