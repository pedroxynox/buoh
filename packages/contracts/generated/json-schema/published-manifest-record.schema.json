{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PublishedManifestRecord",
  "$defs": {
    "PublishedManifestRecord": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
        },
        "publication_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifest_document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_object_uri": {
          "type": "string",
          "format": "uri"
        },
        "manifest_object_bytes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "published_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "superseded"
          ]
        }
      },
      "required": [
        "schema_version",
        "publication_id",
        "dataset_id",
        "manifest_document_sha256",
        "manifest_object_uri",
        "manifest_object_bytes_sha256",
        "published_at_utc",
        "state"
      ],
      "additionalProperties": false,
      "title": "PublishedManifestRecord"
    }
  }
}
