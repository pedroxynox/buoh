            },
            "condition_event_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "condition_key": {
              "type": "string",
              "pattern": "^(?:connection_lost|event_gap_unresolved|persistence_unavailable|source_limit_exceeded):sha256:[0-9a-f]{64}$"
            },
            "condition_type": {
              "type": "string",
              "enum": [
                "connection_lost",
                "event_gap_unresolved",
                "persistence_unavailable",
                "source_limit_exceeded"
              ]
            },
