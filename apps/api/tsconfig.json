{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@buoh/contracts": ["../../packages/contracts/src/index.ts"],
      "@buoh/domain": ["../../packages/domain/src/index.ts"],
      "@buoh/market-data-worker": ["../market-data-worker/src/index.ts"],
      "@buoh/market-data-worker/lectura": ["../market-data-worker/src/lectura.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "integration/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ]
}
