{
  "name": "@buoh/market-data-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node dist/cli/migrate.js",
    "fixture:publish": "node dist/cli/publish-fixture.js",
    "ingest": "node dist/cli/ingest.js",
    "replay": "node dist/cli/replay.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@buoh/contracts": "workspace:*",
    "@buoh/domain": "workspace:*",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2"
  }
}
