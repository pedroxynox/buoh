{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@buoh/contracts": ["../../packages/contracts/src/index.ts"],
      "@buoh/design-system": ["../../packages/design-system/src/index.ts"],
      "@buoh/prototype-data": ["../../packages/prototype-data/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "vitest.config.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": ["node_modules", "out", ".expo"]
}
