{
  "schema_version": "1.0.0",
  "rules": [
    {
      "id": "contracts",
      "description": "Los contratos runtime deben mantener su semántica canónica.",
      "includes": ["packages/contracts/**"],
      "requires_any": ["docs/arquitectura/contratos-de-dominio.md"]
    },
    {
      "id": "toolchain",
      "description": "Cambios de toolchain deben reflejar decisión o estado vigente.",
      "includes": [
        ".node-version",
        ".npmrc",
        ".prettierignore",
        ".prettierrc.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        "turbo.json",
        "eslint.config.mjs",
        "scripts/check-runtime.mjs"
      ],
      "requires_any": ["docs/arquitectura/adr/0003-lenguajes-y-limites.md", "PROJECT_STATUS.md"]
    },
    {
      "id": "market-data-worker",
      "description": "La operación del worker debe conservar un runbook vigente.",
      "includes": ["apps/market-data-worker/**", "scripts/data-replay.*", "scripts/data-smoke.*"],
      "requires_any": [
        "docs/operacion/runbook-ingesta-de-datos.md",
        "docs/arquitectura/adr/0004-pipeline-y-reproduccion-de-datos-fase-1.md"
      ]
    },
    {
      "id": "infrastructure",
      "description": "Persistencia y despliegue requieren revisar arquitectura u operación.",
      "includes": ["infra/**", "render.yaml", "scripts/render-blueprint.*"],
      "requires_any": [
        "docs/arquitectura/adr/0004-pipeline-y-reproduccion-de-datos-fase-1.md",
        "docs/operacion/runbook-ingesta-de-datos.md",
        "docs/operacion/despliegue-en-render.md"
      ]
    },
    {
      "id": "test-vectors",
      "description": "Cambiar el oráculo requiere justificar el contrato o la decisión.",
      "includes": ["test-vectors/**"],
      "requires_any": [
        "docs/arquitectura/contratos-de-dominio.md",
        "docs/arquitectura/adr/0004-pipeline-y-reproduccion-de-datos-fase-1.md"
      ]
    },
    {
      "id": "design-system",
      "description": "Los tokens y componentes de marca deben coincidir con la guía de marca.",
      "includes": ["packages/design-system/**"],
      "requires_any": ["docs/diseno/marca-buoh.md"]
    },
    {
      "id": "web-clients",
      "description": "El prototipo web y sus datos ficticios deben seguir el concepto de interfaz y ADR-0008.",
      "includes": ["apps/web/**", "packages/prototype-data/**"],
      "requires_any": [
        "docs/diseno/concepto-de-interfaz.md",
        "docs/arquitectura/adr/0008-linea-visual-marca-y-clientes-web.md"
      ]
    },
    {
      "id": "mobile",
      "description": "El prototipo móvil debe seguir el concepto de interfaz y ADR-0009.",
      "includes": ["apps/mobile/**"],
      "requires_any": [
        "docs/diseno/concepto-de-interfaz.md",
        "docs/arquitectura/adr/0009-prototipo-movil.md"
      ]
    },
    {
      "id": "desktop",
      "description": "El prototipo de escritorio debe seguir el concepto de interfaz y ADR-0010.",
      "includes": ["apps/desktop/**", ".github/workflows/desktop.yml"],
      "requires_any": [
        "docs/diseno/concepto-de-interfaz.md",
        "docs/arquitectura/adr/0010-prototipo-de-escritorio.md"
      ]
    },
    {
      "id": "site",
      "description": "El sitio oficial debe seguir sus reglas de contenido y ADR-0008.",
      "includes": ["apps/site/**"],
      "requires_any": [
        "docs/diseno/sitio-oficial.md",
        "docs/arquitectura/adr/0008-linea-visual-marca-y-clientes-web.md"
      ]
    },
    {
      "id": "documentation-guard",
      "description": "La política del guard debe permanecer explicada para contribuidores.",
      "includes": ["docs/impact-map.json", "scripts/check-doc-impact.*"],
      "requires_any": ["AGENTS.md", "CONTRIBUTING.md"]
    }
  ]
}
